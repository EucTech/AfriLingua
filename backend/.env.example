DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
PORT=4000

# LiveKit Cloud (video/audio calls) — from your project's API keys page
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="replace-with-your-livekit-api-key"
LIVEKIT_API_SECRET="replace-with-your-livekit-api-secret"

# Cloudinary (avatar/image uploads) — from your Cloudinary dashboard
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
